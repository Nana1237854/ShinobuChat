# ============================================================
# ShinobuChat Configuration
# Copy this file to .env and fill in the values.
# .env is git-ignored and must never be committed.
# ============================================================

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
# PostgreSQL is recommended for development and required for production.
# SQLite may be used for lightweight local testing (change driver to sqlite:///...).
SC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/shinobuchat

# ----------------------------------------------------------
# Auth & Encryption
# ----------------------------------------------------------
# Generate a secure secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
SC_JWT_SECRET_KEY=replace-me-in-prod
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SC_CONFIG_ENCRYPTION_KEY=

# ----------------------------------------------------------
# AI / LLM — Primary (used by general chat, vision, diary, etc.)
# ----------------------------------------------------------
# API key for the AI provider
SC_AI_API_KEY=
# Base URL for OpenAI-compatible API
SC_AI_BASE_URL=https://api.openai.com/v1
# Model name
SC_AI_MODEL=gpt-4o-mini
# Request timeout in seconds
SC_AI_REQUEST_TIMEOUT_SECONDS=60
# Set to false if the model cannot process images (OCR fallback will be used)
SC_AI_SUPPORTS_IMAGE_INPUT=true
# Optional: extra JSON fields merged into every chat/completions request body
# Example: SC_AI_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
SC_AI_EXTRA_BODY=
# Max tokens for lightweight orchestration / short roleplay replies
SC_AI_LIGHTWEIGHT_MAX_TOKENS=4096

# ----------------------------------------------------------
# Decision & Roleplay LLM (optional overrides)
# ----------------------------------------------------------
# If left empty, the primary AI settings above are used.
SC_LLM_API_KEY=
SC_LLM_BASE_URL=https://api.deepseek.com/v1
SC_DECISION_LLM_API_KEY=
SC_DECISION_LLM_BASE_URL=https://api.deepseek.com/v1
SC_DECISION_LLM_MODEL=deepseek-chat
SC_DECISION_LLM_TEMPERATURE=0.1
SC_DECISION_LLM_MAX_TOKENS=512
SC_ROLEPLAY_LLM_API_KEY=
SC_ROLEPLAY_LLM_BASE_URL=https://api.deepseek.com/v1
SC_ROLEPLAY_LLM_MODEL=deepseek-chat
SC_ROLEPLAY_LLM_TEMPERATURE=0.8
SC_ROLEPLAY_LLM_MAX_TOKENS=2048

# ----------------------------------------------------------
# Agent orchestration
# ----------------------------------------------------------
# Maximum tool/skill loop steps per single-turn agent invocation
SC_AGENT_MAX_STEPS=50
# Agent skill timeout in seconds
SC_SKILL_TIMEOUT_SECONDS=120
# Debounce window for decision loop in milliseconds
SC_DECISION_DEBOUNCE_MS=300

# ----------------------------------------------------------
# Memory
# ----------------------------------------------------------
SC_MEMORY_ENABLED=true
# pgvector extension (PostgreSQL only)
SC_MEMORY_PGVECTOR_ENABLED=false
SC_MEMORY_MAX_RESULTS=3
# Local embedding model (sentence-transformers)
SC_MEMORY_EMBEDDING_MODEL=all-MiniLM-L6-v2
SC_MEMORY_EMBEDDING_DIMENSIONS=384
# Optional: remote embedding API (OpenAI-compatible)
SC_MEMORY_EMBEDDING_BASE_URL=
SC_MEMORY_EMBEDDING_API_KEY=

# ----------------------------------------------------------
# Diary
# ----------------------------------------------------------
SC_DIARY_ENABLED=true

# ----------------------------------------------------------
# Image upload budget
# ----------------------------------------------------------
SC_IMAGE_MAX_INPUT_BYTES=41943040
SC_IMAGE_MAX_OUTPUT_BYTES=4194304
SC_IMAGE_MAX_SIDE=3072
SC_IMAGE_MAX_PIXELS=24000000

# ----------------------------------------------------------
# File upload budget
# ----------------------------------------------------------
SC_FILE_MAX_INPUT_BYTES=209715200

# ----------------------------------------------------------
# Voice — TTS (edge-tts)
# ----------------------------------------------------------
SC_EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
SC_EDGE_TTS_RATE=+0%
SC_EDGE_TTS_VOLUME=+0%

# ----------------------------------------------------------
# Voice — ASR (Speech-to-Text)
# ----------------------------------------------------------
# Options: "whisper" (default), "funasr"
SC_ASR_ENGINE=whisper
SC_ASR_TIMEOUT_SECONDS=90
# FunASR (self-hosted)
SC_FUNASR_API_URL=
# Whisper (OpenAI-compatible)
SC_WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
SC_WHISPER_API_KEY=
SC_WHISPER_MODEL=whisper-1
SC_WHISPER_LANGUAGE=

# ----------------------------------------------------------
# Reminders
# ----------------------------------------------------------
SC_REMINDER_ENABLED=true
# Background reminder scanning (disable if only using manual checks)
SC_REMINDER_BACKGROUND_ENABLED=false
SC_REMINDER_SCAN_INTERVAL_SECONDS=60
SC_REMINDER_DUE_SOON_MINUTES=15

# ----------------------------------------------------------
# Google Search (for web search skills)
# ----------------------------------------------------------
SC_GOOGLE_SEARCH_API_KEY=
SC_GOOGLE_SEARCH_CX=

# ----------------------------------------------------------
# Sync & Notifications
# ----------------------------------------------------------
SC_SYNC_HEARTBEAT_SECONDS=20
SC_APNS_OFFLINE_FALLBACK_ENABLED=true
SC_APNS_SANDBOX=true
SC_OAUTH2_DEVICE_CODE_TTL_SECONDS=900
SC_OAUTH2_POLL_INTERVAL_SECONDS=5
