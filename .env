# ============================================================
# ShinobuChat Configuration
# ============================================================

# PostgreSQL
SC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/shinobuchat

# Auth
SC_JWT_SECRET_KEY=replace-me-in-prod

# Memory (pgvector)
SC_MEMORY_PGVECTOR_ENABLED=true

# ----------------------------------------------------------
# OpenAI-compatible LLM settings
# ----------------------------------------------------------
SC_AI_API_KEY=sk-bc7fc03d2cc44339aff640b57c527d52
SC_AI_MODEL=deepseek-chat
SC_AI_BASE_URL=https://api.deepseek.com
SC_AI_REQUEST_TIMEOUT_SECONDS=60
# Disable when the configured LLM cannot inspect images.
SC_AI_SUPPORTS_IMAGE_INPUT=true
# Optional: extra fields merged into every chat/completions request body (JSON object)
# Example: SC_AI_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
SC_AI_EXTRA_BODY=

# ----------------------------------------------------------
# Lightweight orchestration max_tokens budget
# Used by the decision layer and short roleplay replies
# ----------------------------------------------------------
SC_AI_LIGHTWEIGHT_MAX_TOKENS=4096

# ----------------------------------------------------------
# Single-turn agent tool/skill loop step limit
# ----------------------------------------------------------
SC_AGENT_MAX_STEPS=50

# ----------------------------------------------------------
# Image upload budget
# ----------------------------------------------------------
SC_IMAGE_MAX_INPUT_BYTES=41943040
SC_IMAGE_MAX_OUTPUT_BYTES=4194304
SC_IMAGE_MAX_SIDE=3072
SC_IMAGE_MAX_PIXELS=24000000

# ----------------------------------------------------------
# File upload budget
# ----------------------------------------------------------
SC_FILE_MAX_INPUT_BYTES=209715200
